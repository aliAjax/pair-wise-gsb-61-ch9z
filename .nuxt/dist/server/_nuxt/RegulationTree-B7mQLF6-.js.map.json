{"file":"RegulationTree-B7mQLF6-.js","mappings":";;;;;;;;;;;;;AAGA,UAAM,QAAQ;AAKd,UAAM,WAAW,IAAc,MAAM,YAAY,IAAI,CAAC,SAAS,KAAK,EAAE,CAAC;AAQvE,aAAS,eAAe,IAAY;AAClC,aAAO,MAAM,SAAS,OAAO,CAAC,SAAS,KAAK,iBAAiB,EAAE;AAAA,IACjE;;;;;AAIO,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,kEAA8D,MAAA,CAAA,CAAA,WAAA;AACzCC,oBAAA,QAAA,cAAd,eAAU;AAQmB,cAAA,sOAAAC,eAAA,WAAW,IAAI,CAAA,WAAA;;UAC5C,OAAM;AAAA,UAAO,SAAQ;AAAA,QAAA;2BAA7B,CAAsE,GAAAC,QAAAC,UAAA,aAAA;;AAA/BD,qBAAA,GAAAD,eAAA,WAAW,QAAQ,CAAA,EAAA;AAAA;;gBAAnBG,gBAAAC,gBAAA,WAAW,QAAQ,GAAA,CAAA;AAAA,cAAA;AAAA;;;;;UAEvD,OAAO,WAAW,WAAM,aAAA,UAA4B,WAAW,WAAM,aAAA,QAAA;AAAA,UACtE,SAAQ;AAAA,QAAA;2BAFV,CAKS,GAAAH,QAAAC,UAAA,aAAA;;AADJD,qBAAA,GAAAD,eAAA,WAAW,WAAM,aAAA,OAAyB,WAAW,WAAM,aAAA,SAAA,IAAA,CAAA,EAAA;AAAA;;gBAA3DG,gBAAAC,gBAAA,WAAW,WAAM,aAAA,OAAyB,WAAW,WAAM,aAAA,SAAA,IAAA,GAAA,CAAA;AAAA,cAAA;AAAA;;;;oFAGHJ,eAAA,WAAW,KAAK,gEAEhCA,eAAA,WAAW,QAAQ,QAAUA,eAAAK,MAAA,QAAA,EAAS,SAAS,WAAW,EAAE,IAAA,OAAA,IAAA;AAGpG,YAAAA,MAAA,QAAA,EAAS,SAAS,WAAW,EAAE,GAAA;AAGV,gBAAA,0LAAAL,eAAA,WAAW,QAAQ,CAAA,gBAAA;;YAEnC,OAAO,WAAW;AAAA,YAAU,MAAK;AAAA,UAAA;;cAGpC,WAAW,OAAO,QAAM;;0BACd,WAAW,QAAM,CAA1B,UAAK;yGACV,KAAK,CAAA,MAAA;AAAA;;;;;AAID,cAAA,eAAe,WAAW,EAAE,EAAE,QAAM;;AAE5BD,0BAAA,eAAe,WAAW,EAAE,IAApC,SAAI;qKAKyBC,eAAA,KAAK,IAAI,qDAEjCA,eAAA,KAAK,OAAO,UAAYA,eAAA,KAAK,eAAe,sBAAS,KAAK,eAAe,KAAI,GAAA,CAAA;;gBAG3E,QAAQ,KAAK;AAAA,cAAA;;;;;;;;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_ssrRenderList","_ssrInterpolate","_push","_parent","_createTextVNode","_toDisplayString","_unref"],"sources":["../../../../components/RegulationTree.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport type { EvidenceItem, RegulationItem } from '~/types/certification';\n\nconst props = defineProps<{\n  regulations: RegulationItem[];\n  evidence: EvidenceItem[];\n}>();\n\nconst expanded = ref<string[]>(props.regulations.map((item) => item.id));\n\nfunction toggle(id: string) {\n  expanded.value = expanded.value.includes(id)\n    ? expanded.value.filter((item) => item !== id)\n    : [...expanded.value, id];\n}\n\nfunction linkedEvidence(id: string) {\n  return props.evidence.filter((item) => item.regulationId === id);\n}\n</script>\n\n<template>\n  <div class=\"divide-y divide-slate-200 border-y border-slate-200 bg-white\">\n    <section v-for=\"regulation in regulations\" :key=\"regulation.id\">\n      <button\n        type=\"button\"\n        class=\"flex w-full items-start justify-between gap-4 px-4 py-4 text-left hover:bg-slate-50\"\n        @click=\"toggle(regulation.id)\"\n      >\n        <span class=\"min-w-0\">\n          <span class=\"flex flex-wrap items-center gap-2\">\n            <strong class=\"font-mono text-sm\">{{ regulation.code }}</strong>\n            <UBadge color=\"gray\" variant=\"soft\">{{ regulation.category }}</UBadge>\n            <UBadge\n              :color=\"regulation.status === 'complete' ? 'green' : regulation.status === 'conflict' ? 'red' : 'amber'\"\n              variant=\"soft\"\n            >\n              {{ regulation.status === 'complete' ? '完整' : regulation.status === 'conflict' ? '版本冲突' : '缺失' }}\n            </UBadge>\n          </span>\n          <span class=\"mt-1 block text-sm font-medium text-slate-800\">{{ regulation.title }}</span>\n        </span>\n        <span class=\"shrink-0 text-sm text-slate-500\">{{ regulation.coverage }}% · {{ expanded.includes(regulation.id) ? '收起' : '展开' }}</span>\n      </button>\n\n      <div v-if=\"expanded.includes(regulation.id)\" class=\"border-t border-slate-100 bg-slate-50 px-4 py-4\">\n        <div class=\"mb-3\">\n          <div class=\"mb-1 flex items-center justify-between gap-3 text-xs text-slate-500\">\n            <span>配置覆盖</span><span>{{ regulation.coverage }}%</span>\n          </div>\n          <UProgress :value=\"regulation.coverage\" size=\"xs\" />\n        </div>\n\n        <div v-if=\"regulation.issues.length\" class=\"mb-4 space-y-1\">\n          <p v-for=\"issue in regulation.issues\" :key=\"issue\" class=\"border-l-2 border-amber-500 pl-3 text-sm text-amber-900\">\n            {{ issue }}\n          </p>\n        </div>\n\n        <div v-if=\"linkedEvidence(regulation.id).length\" class=\"space-y-2\">\n          <div\n            v-for=\"item in linkedEvidence(regulation.id)\"\n            :key=\"item.id\"\n            class=\"flex flex-wrap items-center justify-between gap-3 border border-slate-200 bg-white px-3 py-3\"\n          >\n            <div>\n              <p class=\"text-sm font-medium\">{{ item.name }}</p>\n              <p class=\"mt-1 text-xs text-slate-500\">\n                文件版本 {{ item.version }} · 软件 {{ item.softwareVersion }} · {{ item.configurations.join('、') }}\n              </p>\n            </div>\n            <StatusBadge :status=\"item.status\" />\n          </div>\n        </div>\n        <p v-else class=\"text-sm text-slate-500\">尚未关联证据文件。</p>\n      </div>\n    </section>\n  </div>\n</template>\n"],"version":3}